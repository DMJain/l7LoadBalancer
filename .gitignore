# Binaries
/bin/
*.exe
*.test
*.out

# Coverage
coverage.*

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Local env
.env
.env.local

# Generated TLS certificates (scripts/generate-cert.sh)
/certs/

# Benchmark artifacts (raw outputs kept intentionally in bench/results/)
bench/tmp/
# Raw per-attack scratch (gob/csv/report) written by bench/run.sh
bench/results/.tmp/

# Go build cache (not usually needed but just in case)
/vendor/


# Cross-tool agent skill copies (local convenience for Antigravity/OpenCode; not portfolio content)
/.agents/
# OpenCode's project skill path: symlink into .agents/skills so OpenCode loads
# each skill exactly once (see docs/agents/skills.md).
/.opencode/skills
/.opencode/commands
